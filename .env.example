# Google Gemini AI API Key (required)
GOOGLE_API_KEY=your-gemini-api-key-here

# Application Configuration
APP_ENV=development
PORT=8000
MODEL_NAME=gemini-3.5-flash-lite

# CORS Origins (comma-separated list or JSON array, e.g. http://localhost:3000,http://localhost:8000 or *)
CORS_ORIGINS=*

# LangSmith Tracing Configuration (optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_AGENT_ID=luca-agent-core
LANGSMITH_AGENT_ENVIRONMENT=development
# Note: When using Agent tracing (LANGSMITH_AGENT_ID), omit LANGSMITH_PROJECT to avoid addressing conflicts.
